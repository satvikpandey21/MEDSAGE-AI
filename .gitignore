# Root gitignore for MedSage AI
node_modules/
dist/

# Environment variable files (never commit secrets)
.env
.env.local
.env.*.local
*.local

# Logs
logs/
*.log
.env
.env.*
!.env.example
.venv/
backend/.venv/
# Python generated files
__pycache__/
*.py[cod]
# Isolated local PostgreSQL validation dependencies
.ocr-sql-validation/

# Dedicated local OCR virtual environment
.venv-ocr/

# Sensitive local database backups, restore manifests and preflight results
/.local-backups/
