GEMINI_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional CPU OCR. Local extracted inference model directories only.
PADDLE_OCR_ENABLED=false
PADDLE_OCR_DET_MODEL_DIR=
PADDLE_OCR_REC_MODEL_DIR=

# Production requires explicit comma-separated HTTPS frontend origins.
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
