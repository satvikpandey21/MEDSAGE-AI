# ==============================================================================
# MedSage AI - Supabase Environment Configuration Template
# ==============================================================================
# Instructions for beginners:
# 1. Duplicate this file and rename the copy to '.env.local' in the 'frontend/' directory.
# 2. Replace the placeholder values below with your actual credentials from Supabase:
#    - Navigate to your Supabase Project Dashboard
#    - Go to: Project Settings -> API
#    - Copy "Project URL" into VITE_SUPABASE_URL
#    - Copy "Publishable Key" (anon public) into VITE_SUPABASE_PUBLISHABLE_KEY
# 3. Never commit '.env.local' or paste your 'service_role' (secret) key here!
# ==============================================================================

# Your Supabase Project URL (found under Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Public Key (found under Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Prescription analysis backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production: replace with the public HTTPS backend origin and rebuild.
# VITE_API_URL remains supported only as a legacy alias.
